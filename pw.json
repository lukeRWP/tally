{
  "schemaVersion": 1,
  "name": "tally",
  "displayName": "Tally Home Inventory",
  "repo": "git@github.com:lukeRWP/Tally.git",
  "services": {
    "app": {
      "type": "nodejs",
      "build": [
        {
          "dir": "client",
          "cmd": "./node_modules/.bin/eslint . --max-warnings 0 && npm run build",
          "output": "dist"
        },
        {
          "dir": "server",
          "cmd": "node scripts/write-version.js"
        }
      ],
      "port": 2727,
      "healthCheck": {
        "path": "/health/ready",
        "port": 2727
      }
    },
    "db": {
      "type": "mysql",
      "databases": [
        "TALLY"
      ]
    },
    "storage": {
      "type": "minio",
      "buckets": [
        "tally-files"
      ]
    },
    "web": {
      "type": "nginx",
      "upstream": "app:2727",
      "headers": {
        "csp": "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'",
        "permissionsPolicy": "camera=(self), geolocation=(), microphone=()"
      }
    }
  },
  "secrets": [
    "MYSQL_ROOT_PASSWORD",
    "MYSQL_PASSWORD",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "COOKIE_SECRET"
  ],
  "external_secrets": [
    "ANTHROPIC_API_KEY"
  ],
  "iam": {
    "roles": [
      "admin",
      "user"
    ],
    "redirectUris": [
      "/api/auth/callback"
    ],
    "serviceAccounts": [
      "print-agent"
    ]
  },
  "hardening": { "loopbackPorts": true, "appUser": "node", "scopedEnv": true, "realIp": true },
  "environments": {
    "prod": {
      "publicHost": "tally.razorwire-productions.com",
      "pipeline": {
        "autoDeployBranch": "master",
        "requiresApproval": false
      },
      "services": {
        "app": {
          "image": "node:22-bookworm-slim@sha256:f3a68cf41a855d227d1b0ab832bed9749469ef38cf4f58182fb8c893bc462383",
          "command": [
            "node",
            "index.js"
          ],
          "init": true,
          "working_dir": "/app/server",
          "volumes": [
            "./server:/app/server",
            "./client/dist:/app/client/dist:ro"
          ],
          "environment": {
            "TALLY_DB": "TALLY",
            "MYSQL_URL": "db",
            "MYSQL_USER": "tally",
            "MYSQL_PASSWORD": "${MYSQL_PASSWORD}",
            "S3_BUCKET": "tally-files",
            "CLIENT_URL": "https://tally.razorwire-productions.com",
            "PORT": "2727"
          }
        },
        "db": {
          "volumes": [
            "./init-db.sql:/docker-entrypoint-initdb.d/init-db.sql:ro"
          ]
        }
      }
    }
  }
}
