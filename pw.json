{
  "name": "tally",
  "displayName": "Tally Home Inventory",
  "repo": "git@github.com:lukeRWP/Tally.git",
  "services": {
    "app": {
      "type": "nodejs",
      "build": [
        {
          "dir": "client",
          "cmd": "npm run build",
          "output": "dist"
        },
        {
          "dir": "server",
          "cmd": "true"
        }
      ],
      "port": 2727,
      "healthCheck": {
        "path": "/health/live",
        "port": 2727
      }
    },
    "db": {
      "type": "mysql",
      "databases": [
        "TALLY"
      ]
    },
    "storage": {
      "type": "minio",
      "buckets": [
        "tally-files"
      ]
    },
    "web": {
      "type": "nginx",
      "upstream": "app:2727"
    }
  },
  "secrets": [
    "MYSQL_ROOT_PASSWORD",
    "MYSQL_PASSWORD",
    "MYSQL_SSL_PASSWORD",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "AUTH_SECRET_ENCRYPTION_KEY",
    "COOKIE_SECRET",
    "FILE_ENCRYPTION_MASTER_KEY",
    "SYNC_ENCRYPTION_KEY"
  ],
  "external_secrets": [
    "ENTRA_TENANT_ID",
    "ENTRA_CLIENT_ID",
    "ENTRA_CLIENT_SECRET"
  ],
  "environments": {
    "prod": {
      "pipeline": {
        "autoDeployBranch": "master",
        "requiresApproval": false
      },
      "services": {
        "app": {
          "image": "node:22-bookworm-slim",
          "command": [
            "node",
            "index.js"
          ],
          "working_dir": "/app/server",
          "volumes": [
            "./server:/app/server",
            "./client/dist:/app/client/dist:ro"
          ],
          "environment": {
            "MAIN_DATABASE": "TALLY",
            "MYSQL_URL": "db",
            "MYSQL_USER": "root",
            "MYSQL_PASSWORD": "${MYSQL_ROOT_PASSWORD}",
            "CLIENT_URL": "https://tally.razorwire-productions.com",
            "PORT": "2727"
          }
        },
        "db": {
          "volumes": [
            "./init-db.sql:/docker-entrypoint-initdb.d/init-db.sql:ro"
          ]
        },
        "web": {
          "volumes": [
            "./nginx.conf:/etc/nginx/conf.d/default.conf:ro",
            "./client/dist:/usr/share/nginx/html:ro"
          ]
        }
      }
    }
  }
}
