# ============================================================
# Tally Configuration Template
# Copy to .env and fill in required values.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=2727
CLIENT_URL=http://localhost:8080

# --- Database ---
MYSQL_URL=tally-db
MYSQL_USER=tally_api
MYSQL_PASSWORD=tally_dev_password
MYSQL_ROOT_PASSWORD=tally_root_password
MYSQL_USE_SSL=false
TALLY_DB=TALLY

# --- File Storage (MinIO) ---
S3_BUCKET=tally-files
S3_REGION=us-east-1
S3_ACCESS_KEY=tallydevaccess
S3_SECRET_KEY=tallydevsecret
S3_ENDPOINT=http://tally-minio:9000
# The endpoint a BROWSER can reach. Presigned URLs are signed against a host,
# so this must be the PUBLISHED port from docker-compose.yml (9002:9000), not
# the container's internal 9000 — signing against the internal name produced
# links the client could never load, which is why photos never appeared.
S3_PUBLIC_ENDPOINT=http://localhost:9002

# --- Auth (PW IAM / pwiam, via @pw/auth-express) ---
# In prod the orchestrator's reconcile writes these three to Vault and renders
# them into .env on every deploy (pw.json `iam`) — they are NEVER declared in
# pw.json secrets/external_secrets. Locally, BYPASS_AUTH=true needs none of
# them: the shim serves a fixed dev principal and /api/auth/login is a 503.
# Fill them in only to sign in against the real pwiam from a dev box.
PW_IAM_ISSUER=https://id.razorwire-productions.com
PW_IAM_CLIENT_ID=
PW_IAM_CLIENT_SECRET=
# ≥ 32 chars: signs the session cookie and seals the pwiam tokens in
# TALLY.sessions.IAM_STATE (HKDF → two keys).
COOKIE_SECRET=tally-dev-cookie-secret-min-32-chars!!

# --- Logging ---
LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILE=false

# --- Dev ---
BYPASS_AUTH=true

# --- Photo identification (optional) ---
# Absent = the capture flow behaves exactly as it did before. The endpoint
# answers available:false, the client stops asking, nothing else changes.
ANTHROPIC_API_KEY=
# The second way off, and the one to reach for at 2am when the bill is wrong,
# because it does not require touching the vault.
VISION_ENABLED=true
VISION_MODEL=claude-sonnet-5
# Long edge the model sees. 1024 is enough to read a product name off a box;
# raising it improves small print (model numbers, "20V MAX") and costs more.
VISION_MAX_EDGE=1024
VISION_TIMEOUT_MS=12000
VISION_DAILY_PER_USER=250
