{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Dead code used to ship silently: there is no eslint here, so unused
    // imports and unreachable helpers survived every review (the #114-#116
    // restyle left ~10 behind). These make tsc the guardrail instead.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    // No baseUrl: TS 6 deprecates it (gone in 7). Bare `paths` resolves
    // relative to this file, which is what baseUrl:"." meant anyway.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
